using Gtk 4.0;

template $SrAppCard: Box {
  orientation: horizontal;
  spacing: 14;
  width-request: 260;

  styles [
    "card",
    "app-card",
  ]

  Image icon {
    pixel-size: 64;
    valign: center;
    accessible-role: presentation;

    styles [
      "icon-dropshadow",
    ]
  }

  Box {
    orientation: vertical;
    valign: center;
    hexpand: true;
    spacing: 3;

    Box {
      spacing: 8;

      Label title {
        xalign: 0;
        ellipsize: end;
        max-width-chars: 18;

        styles [
          "heading",
        ]
      }

      Label pill {
        valign: center;
        ellipsize: end;
        max-width-chars: 12;

        styles [
          "source-pill",
        ]
      }
    }

    Label subtitle {
      xalign: 0;
      yalign: 0;
      wrap: true;
      wrap-mode: word_char;
      lines: 2;
      ellipsize: end;
      width-chars: 24;
      max-width-chars: 24;

      styles [
        "app-card-subtitle",
      ]
    }
  }
}
