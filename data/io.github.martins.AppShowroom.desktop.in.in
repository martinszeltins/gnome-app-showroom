[Desktop Entry]
Name=App Showroom
Comment=Browse installed apps and packages by where they came from
Exec=app-showroom
Icon=@APP_ID@
Terminal=false
Type=Application
Categories=GTK;GNOME;System;PackageManager;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=apps;applications;flatpak;snap;deb;appimage;packages;installed;
StartupNotify=true
DBusActivatable=false
