{
  "id": "io.github.martins.AppShowroom",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "app-showroom",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=host:ro",
    "--filesystem=host-os:ro",
    "--filesystem=host-etc:ro",
    "--filesystem=/var/lib/flatpak:ro",
    "--filesystem=/var/lib/snapd:ro",
    "--filesystem=/snap:ro",
    "--filesystem=/var/lib/dpkg:ro",
    "--filesystem=/var/lib/apt:ro",
    "--filesystem=/opt:ro",
    "--filesystem=~/.local/share/flatpak:ro",
    "--filesystem=xdg-data/applications:ro",
    "--filesystem=xdg-data/icons:ro",
    "--talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.freedesktop.FileManager1"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/man",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "squashfs-tools",
      "buildsystem": "simple",
      "build-commands": [
        "make -C squashfs-tools -j${FLATPAK_BUILDER_N_JOBS} unsquashfs GZIP_SUPPORT=1 XZ_SUPPORT=1 LZ4_SUPPORT=1 ZSTD_SUPPORT=1 LZO_SUPPORT=0 LZMA_SUPPORT=0 XATTR_SUPPORT=0",
        "install -Dm755 squashfs-tools/unsquashfs ${FLATPAK_DEST}/bin/unsquashfs"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/plougher/squashfs-tools/archive/refs/tags/4.7.5.tar.gz",
          "sha256": "547b7b7f4d2e44bf91b6fc554664850c69563701deab9fd9cd7e21f694c88ea6"
        }
      ]
    },
    {
      "name": "app-showroom",
      "buildsystem": "meson",
      "builddir": true,
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
